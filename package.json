{
  "name": "neural-car",
  "version": "1.0.0",
  "private": true,
  "nx": {
    "projectType": "application",
    "sourceRoot": "src",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc -w"
        }
      },
      "copy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "chokidar \"src/**/*.html\" -c \"copyfiles -u 1 src/**/*.html dist\""
        }
      },
      "sass": {
        "cache": false,
        "executor": "nx:run-commands",
        "options": {
          "command": "sass --watch src/styles:dist/styles"
        }
      },
      "live": {
        "executor": "nx:run-commands",
        "options": {
          "command": "live-server dist"
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "concurrently \"nx run sass\" \"nx build\" \"nx copy\"  \"nx live\""
        }
      }
    }
  },
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "copyfiles": "^2.4.1",
    "live-server": "^1.2.2",
    "sass": "^1.96.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "nx": "^22.2.3"
  }
}